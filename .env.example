# --- API KEYS ---
# System OpenRouter key (users can also bring their own key in the UI)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# ElevenLabs key for premium voices (audio/video pipeline). Without it the free Edge
# voices are used; users can also bring their own key in the UI. When you create the key
# in the ElevenLabs dashboard give it these permissions: Text to Speech, Voices (read),
# User (read), Forced alignment. A restricted key without them is rejected with 401.
ELEVENLABS_API_KEY=

# --- ENVIRONMENT ---
# development | production (production makes placeholder secrets a startup error)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- DOMAIN & SSL ---
# Public site URL: share links, the `debatr login` page, Stripe redirects, OpenRouter's referer
SITE_URL=http://localhost
# Only for serving frontend/Caddyfile with TLS by itself. Docker Compose ignores both: the frontend
# container speaks plain HTTP on :80 and production puts a TLS proxy in front (see README).
DOMAIN_NAME=localhost
ACME_EMAIL=your-email@example.com

# --- SEARCH ENGINES ---
# robots.txt lets AI crawlers (GPTBot, ClaudeBot, PerplexityBot, Google-Extended…) read the public
# pages; false refuses them. Outside production robots.txt refuses every crawler anyway.
SEO_ALLOW_AI_CRAWLERS=true
# IndexNow (Bing, Yandex, Seznam, Naver, Yep learn about new and removed debates within a minute):
# any 8-128 letters, digits or dashes, e.g. `openssl rand -hex 16`. Served at /<key>.txt; works
# only in production with an https SITE_URL. Empty = off.
INDEXNOW_KEY=
# Link preview pictures (/og/*, 1200×630) are drawn once and kept in the og_cache volume; past this
# size the least recently used ones are dropped (and drawn again when asked for).
OG_CACHE_MAX_MB=256

# --- SECRETS ---
# Signs login cookies and encrypts stored OpenRouter keys and admin TOTP secrets
# (openssl rand -base64 48). Changing it signs everyone out and needs those re-entered.
SECRET_KEY=generate-a-random-string-here

# --- ADMIN CONSOLE (/admin) ---
# Admins are accounts given a role on the server:
#   docker compose exec api python -m app.manage admin grant you@example.com
# (prints a one-time code for setting up an authenticator app; sign-in = password + TOTP).
# Host of the console, e.g. admin.your-domain.com: its own origin, proxied to the frontend
# container like the site. Empty: the site's origin in development, console off in production.
ADMIN_HOST=
# Optional comma-separated CIDRs allowed to reach the console (empty = any address)
ADMIN_ALLOWED_IPS=
# Credit adjustments above this need a fresh authenticator code
ADMIN_SUDO_USD=20
# Development only: sign in to the console with the password alone (no authenticator, no
# confirmation codes). Ignored in production.
ADMIN_SKIP_2FA=false
# Optional alerts in Telegram (console sign-ins, failed sign-ins, flagged debates, failure
# spikes, stuck runs, low OpenRouter balance / ElevenLabs characters, top-ups, full disk): a bot
# token from @BotFather and the chat it writes to (your user id, or a group with the bot in it).
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# --- DATABASE ---
# Note: if the password contains special characters, URL-encode them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_debates

# --- BACKUPS (scripts/backup-db.sh, `make backup`; run it from cron on the server) ---
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# Off-site copy with rclone; use an encrypted `crypt` remote (dumps hold emails and the ledger)
# BACKUP_RCLONE_REMOTE=offsite:debatr-db
# BACKUP_REMOTE_KEEP_DAYS=60

# --- NETWORKING ---
# Allowed CORS origins (comma separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# --- ACCOUNTS & CREDITS ---
# Welcome credits (USD) for every new account; 0 disables. This and the fair-share and free-model
# limits below are defaults: the admin console's Settings page can change them without a deploy.
SIGNUP_BONUS_USD=0
# Prices (the console's Settings → Prices overrides them; a run keeps the prices it started with).
# Multiplier on the provider cost of models, fact-checks and AI pictures (3 = 3x the cost)
CREDIT_MARKUP=1.2
# A completed debate on paid models costs at least this (USD; 0 = no minimum)
MIN_DEBATE_CHARGE_USD=0
# Premium (ElevenLabs) voices on the system key, charged to credits per 1000 characters
TTS_CREDIT_PRICE_PER_1K_CHARS=0.15
# A rap battle's ElevenLabs Music track on the system key, per minute (ElevenLabs charges ~$0.15)
MUSIC_CREDIT_PRICE_PER_MIN=0.30
# Top-up packages offered in the UI (USD, comma separated)
TOPUP_AMOUNTS_USD=5,10,25
# Stripe Checkout. Without STRIPE_SECRET_KEY payments are disabled (set DEV_FAKE_PAYMENTS=true
# in development to credit top-ups instantly). Point the Stripe webhook at
# https://<your-domain>/api/billing/webhook with the events checkout.session.completed and
# checkout.session.async_payment_succeeded.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
DEV_FAKE_PAYMENTS=false
# Days a login stays valid, expressed in seconds (30 days)
SESSION_MAX_AGE=2592000

# --- LIMITS ---
# Debates one IP may create per hour (0 disables)
DEBATE_CREATE_RATE_LIMIT=20
# Sign-in / sign-up attempts per IP per hour (0 disables)
LOGIN_RATE_LIMIT=30
# Seconds a single LLM turn job may take before it is killed (and the debate fails)
TURN_JOB_TIMEOUT=600
# Seconds one answer may stream before the turn fails (and stops the debate, which can be
# resumed); keep well below TURN_JOB_TIMEOUT: the job also designs the turn's scenes
LLM_TURN_TIMEOUT=300
# Docker: worker replicas for debate turns (each runs one turn at a time)
TURN_WORKERS=4
# Fair share: debates (queued + running) and audio builds one user may have at once (0 = no limit)
MAX_ACTIVE_DEBATES_PER_USER=2
MAX_ACTIVE_MEDIA_PER_USER=2
# Free debates (system key, every model free, an account without credits): how many an account
# may start in any 24 hours and how big they may be; credits or an own OpenRouter key lift the
# limits. 0 / empty = no limit. The console's Settings page overrides them.
FREE_DEBATES_PER_DAY=5
FREE_MAX_ROUNDS=3
FREE_MAX_DEBATERS=4
FREE_LENGTHS=very_short,short
# `:free` model requests a minute on the system key, all users together (OpenRouter allows 20
# per account); turns wait for a slot. 0 = no limit
FREE_MODELS_PER_MINUTE=18
# Times a run whose worker died is queued again (scheduler, every minute) before it fails
RECOVERY_ATTEMPTS=2

# --- VERDICT & GALLERY CHECK ---
# Cheap model that structures the judge's verdict (winner, headline) and answers the hidden
# gallery check. Fixed on purpose: the debate's author picks the host and the debaters.
# (Short-video highlights are picked by the debate's own host model.)
VERDICT_MODEL=openai/gpt-4o-mini
# The same for debates whose participants all argue on free models, so they cost nothing: a
# `:free` model (empty = VERDICT_MODEL). The console's Settings page can switch it without a
# deploy when OpenRouter drops the model.
FREE_VERDICT_MODEL=minimax/minimax-m3.1-flash:free

# --- MEDIA (audio + video) ---
# Optional secret: requests with header X-Media-Token get premium voices without credits
# MEDIA_API_TOKEN=
# Default ElevenLabs model: eleven_v4 | eleven_v3 | eleven_multilingual_v2 | eleven_flash_v2_5
TTS_DEFAULT_MODEL_ID=eleven_v4
# Model that designs the visual scenes (charts, drawn schemes) per turn; ~$0.01 per debate
MEDIA_VISUALS_MODEL=google/gemini-2.5-flash
MEDIA_VISUALS_CONCURRENCY=4
# Seconds one audio build may take
MEDIA_JOB_TIMEOUT=3600
# Where generated audio lives. docker compose mounts a volume at /media; natively
# the default ./media (inside backend/) is fine.
# MEDIA_ROOT=./media
# Queues a native worker listens to (docker runs separate worker / media-worker)
# RQ_QUEUES=default,background,media

# --- AI COVERS (a clickbait thumbnail per debate: gallery, link previews, YouTube) ---
# off | paid (runs paid from the balance or an own OpenRouter key get one when they complete) |
# all_public (free public debates too, at your cost). The console's Settings page overrides it.
AI_COVERS=paid
# The art director (reads the debate, never the verdict) and the picture: ~$0.03 a cover
COVER_DIRECTOR_MODEL=anthropic/claude-sonnet-5.5
COVER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
COVER_IMAGE_QUALITY=medium
# Provider cost of one cover for estimates; users pay the real cost x markup
COVER_PRICE_USD=0.035

# --- TRENDING TOPICS (today's news -> debate topics for the wizard) ---
# Hours between batches: 24 in production, e.g. 720 (a month) in development; 0 = off
TRENDING_REFRESH_HOURS=24
# Model that turns ~150 RSS headlines into topics and reviews them (~$0.02 per batch)
TRENDING_MODEL=google/gemini-2.5-flash
# Topics per batch
TRENDING_TOPIC_COUNT=50

# --- INTERNAL URLS ---
# docker compose sets these automatically. For native local development the
# defaults (localhost) match docker-compose.dev.yml, so leave them commented out.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_debates
# REDIS_URL=redis://localhost:6379/0
# The site's server renderer, which draws the covers' logo references (natively `npm run dev`)
# WEB_INTERNAL_URL=http://localhost:5173
# Run RQ jobs in-process (no fork) — recommended for the worker on macOS:
# RQ_SIMPLE_WORKER=true
